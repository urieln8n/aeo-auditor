{
  // Auditor AEO web: auditoria.andresrendon.com
  "name": "aeo-auditor",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    // Sustituye database_id por el que te da: npx wrangler d1 create aeo-auditor
    { "binding": "DB", "database_name": "aeo-auditor", "database_id": "ba48ce76-63cb-4f06-b007-7e23302ddc21" }
  ],
  "vars": {
    "MAX_PAGINAS": "3",
    "LIMITE_DIA_IP": "10",
    "HORAS_CACHE": "12",
    "BREVO_LISTA": "6",
    "BREVO_ATRIBUTO_NOMBRE": "NOMBRE"
  },
  "observability": { "enabled": true }
  // Secretos (npx wrangler secret put NOMBRE -c web/wrangler.jsonc):
  //   SAL            texto aleatorio para anonimizar IPs (obligatorio)
  //   CLAVE_ADMIN    para descargar los contactos en /api/leads?clave=...
  //   BREVO_API_KEY  opcional: manda cada contacto a Brevo
}
